# Relative paths are resolved from the repository root.
DB_PATH=data/app.db
DATA_DIR=data
GENERATED_IMAGES_DIR=data/generated_images
TEMPLATES_DIR=data/templates

# Replacement is implied if performed outside of local testing. (сомневаюсь что это пригодится)
SESSION_SECRET_KEY=replace-with-a-random-secret
SESSION_COOKIE_NAME=devcraft_session
SESSION_COOKIE_SAMESITE=lax

# Use true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
